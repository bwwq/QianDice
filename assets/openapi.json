  "components": {
    "schemas": {
      "Context": {
        "type": "object",
        "required": [
          "platform",
          "account",
          "user"
        ],
        "properties": {
          "platform": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "admin": {
            "type": "boolean",
            "description": "模拟接口忽略客户端角色权限，真实权限来自平台和骰主配置"
          }
        }
      },
      "Config": {
        "type": "object",
        "properties": {
          "listen": {
            "type": "string"
          },
          "masters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "blocked_users": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cooldown_ms": {
            "type": "integer",
            "minimum": 0
          },
          "backup": {
            "$ref": "#/components/schemas/BackupConfig"
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "self_id",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "self_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "forward",
              "reverse"
            ]
          },
          "url": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "writeOnly": true,
            "description": "至少16字符；配置更新时空字符串保留原令牌"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "RevisionValue": {
        "type": "object",
        "required": [
          "value",
          "revision"
        ],
        "properties": {
          "value": {},
          "revision": {
            "type": "integer"
          }
        }
      },
      "CommandResult": {
        "type": "object",
        "properties": {
          "public": {
            "type": "string"
          },
          "private": {
            "type": [
              "string",
              "null"
            ]
          },
          "world": {
            "type": "object"
          },
          "export_log": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PluginManifest": {
        "type": "object",
        "required": [
          "id",
          "version",
          "entry"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "api": {
            "type": "integer"
          },
          "config_schema": {
            "type": "object"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "BackupContents": {
        "type": "object",
        "description": "角色与团录、配置、插件及数据、规则、牌堆、日志文件；缺省全选",
        "properties": {
          "game": {
            "default": true,
            "type": "boolean"
          },
          "config": {
            "default": true,
            "type": "boolean"
          },
          "plugins": {
            "default": true,
            "type": "boolean"
          },
          "rules": {
            "default": true,
            "type": "boolean"
          },
          "decks": {
            "default": true,
            "type": "boolean"
          },
          "logs": {
            "default": true,
            "type": "boolean"
          }
        }
      },
      "BackupConfig": {
        "type": "object",
        "properties": {
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "interval_minutes": {
            "maximum": 525600,
            "minimum": 1,
            "default": 1440,
            "type": "integer"
          },
          "keep": {
            "maximum": 1000,
            "minimum": 1,
            "description": "仅清理自动备份；远端仅清理本实例记录的自动备份",
            "default": 7,
            "type": "integer"
          },
          "contents": {
            "$ref": "#/components/schemas/BackupContents"
          },
          "webdav": {
            "properties": {
              "password": {
                "writeOnly": true,
                "description": "留空保留已保存密码",
                "type": "string"
              },
              "has_password": {
                "type": "boolean",
                "readOnly": true
              },
              "username": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "clear_credentials": {
                "type": "boolean",
                "writeOnly": true
              },
              "url": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "s3": {
            "properties": {
              "secret_key": {
                "type": "string",
                "writeOnly": true
              },
              "has_session_token": {
                "type": "boolean",
                "readOnly": true
              },
              "path_style": {
                "default": true,
                "type": "boolean"
              },
              "has_secret_key": {
                "type": "boolean",
                "readOnly": true
              },
              "bucket": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "session_token": {
                "type": "string",
                "writeOnly": true
              },
              "region": {
                "default": "us-east-1",
                "type": "string"
              },
              "clear_credentials": {
                "type": "boolean",
                "writeOnly": true
              },
              "prefix": {
                "default": "qianbian",
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "access_key": {
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {
      "admin": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "qianbian_session"
      }
    }
  }
}
