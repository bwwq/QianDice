  },
  "components": {
    "schemas": {
      "Context": {
        "type": "object",
        "required": [
          "platform",
          "account",
          "user"
        ],
        "properties": {
          "platform": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "admin": {
            "type": "boolean",
            "description": "模拟接口忽略客户端角色权限，真实权限来自平台和骰主配置"
          }
        }
      },
      "Config": {
        "type": "object",
        "properties": {
          "listen": {
            "type": "string"
          },
          "masters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "blocked_users": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cooldown_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "self_id",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "self_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "forward",
              "reverse"
            ]
          },
          "url": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "writeOnly": true,
            "description": "至少16字符；配置更新时空字符串保留原令牌"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "RevisionValue": {
        "type": "object",
        "required": [
          "value",
          "revision"
        ],
        "properties": {
          "value": {},
          "revision": {
            "type": "integer"
          }
        }
      },
      "CommandResult": {
        "type": "object",
        "properties": {
          "public": {
            "type": "string"
          },
          "private": {
            "type": [
              "string",
              "null"
            ]
          },
          "world": {
            "type": "object"
          },
          "export_log": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PluginManifest": {
        "type": "object",
        "required": [
          "id",
          "version",
          "entry"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "api": {
            "type": "integer"
          },
          "config_schema": {
            "type": "object"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "admin": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "qianbian_session"
      }
    }
  }
}